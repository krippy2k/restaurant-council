# Copy to .dev.vars at the repo root for local Wrangler secrets.
# The variable name must be OPENAI_API_KEY (with the I).

# Required in production. The committed wrangler.jsonc value is for local
# development only and must be replaced with `wrangler secret put`.
SESSION_SECRET=replace-me-in-production

# Frontend origin for CORS and invitation links.
APP_ORIGIN=http://localhost:5173

# development | staging | production
ENVIRONMENT=development

# Optional: production email invitations (never commit the real key)
# RESEND_API_KEY=
# INVITE_FROM_EMAIL=invites@example.com

# Optional: Google Places (New). Without this key the mock provider is used.
# RESTAURANT_PROVIDER=google
# GOOGLE_PLACES_API_KEY=

# LLM-backed Personal Agents and Negotiator (required to start a Council).
# Copy these into a gitignored `.dev.vars` file at the repo root, then restart `pnpm dev`.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
